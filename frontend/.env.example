# 1. Supabase Settings (Get from: https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Resend Email Settings (Get from: https://resend.com/api-keys)
